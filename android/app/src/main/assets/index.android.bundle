               </span>\n                    </div>\n        \n                    <div class="our_company_name_panel">\n        \n                        <div class="section">\n                            \n                            <div style="flex-grow: 1;">\n                                <div class="labelValue" style="font-weight: bold;">${s||''}\n                                </div>\n                            \n                                <div class="labelValue" style="font-weight: bold;">${p||''}\n                                </div>\n                            </div>  \n                            <div class="TrnTop">\n                                <div class="label">CLIENT TRN:</div>\n                                <div class="labelValue">${c?c[0].TRN:''}</div>\n                            </div>\n        \n                        </div>\n        \n                        <div class="TopRightItemCont">\n        \n                            <div>\n                                <div class="TopRightLables">INV NO</div>\n                                <div class="TopRightLables">INV Date</div>\n                                <div class="TopRightLables">INV TYPE</div>\n                                <div class="TopRightLables">LPO</div>\n                                <div class="TopRightLables">SALESMAN</div>\n                             \n                            </div>\n                            <div style="margin-left: 8px; margin-right: 8px;">\n                                <div style="font-weight: bold;">:</div>\n                                <div style="font-weight: bold;">:</div>\n                                <div style="font-weight: bold;">:</div>\n                                <div style="font-weight: bold;">:</div>\n                                <div style="font-weight: bold;">:</div>\n                            </div>\n                            <div>\n                                <div style="font-weight: bold;">${v||''}\n                                </div>\n                                <div style="padding-top:1px">${y}\n                                </div>\n                                <div style="padding-top:1px">\n                                </div>\n                                <div style="padding-top:1px">\n                                </div>\n                                <div style="padding-top:1px"></div>\n                            </div>\n                        </div>\n        \n                    </div>\n        \n                     \n                    \n                    <div class="tableCont">\n        \n                        <table border="1">\n                            <thead>\n                                <tr>\n                                    <th style="width:10%">Sl.No</th>\n                                    <th style="width:15%">CODE</th>\n                                    <th style="width:25%">DESCRIPTION</th>\n                                    <th style="width:10%">QTY</th>\n                                    <th style="width:10%">UNIT PRICE</th>\n                                    <th style="width:10%">TOTAL<br>[Excl. VAT]</br></th>\n                                    <th style="text-align: right;width:10%">VAT<br>@5%</br></th>\n                                    <th style="text-align: right;width:10%">Total<br>[Incl. VAT]</br</th>\n        \n                                </tr>\n                            </thead>\n        \n                            <tbody>\n        \n                               ${c.map((function(n,t){return`\n                               \n                                <tr class="singleRowOfItem" style="border-bottom:2px dashed #7f7f7f">\n                                    <td style="width:10%">${t+1}</td>\n                                    <td style="width:15%">${n.ITEM_CODE}</td>\n                                    <td style="width:25%">${n.DESCRIPTION}</td>\n                                  \n                                    <td style="width:10%">${new Intl.NumberFormat('en-US',{minimumFractionDigits:3,maximumFractionDigits:3}).format(n.QTY)}</td>\n                                    <td style="width:10%">${n.PRICE}</td>\n                                    <td style="width:10%">${n.LINE_TOTAL}</td>\n                                   \n                                    <td style="text-align: right; width:10%">${new Intl.NumberFormat('en-US',{minimumFractionDigits:2,maximumFractionDigits:2}).format(.05*n.LINE_TOTAL)}</td>\n        \n                        <td style="text-align: right; width:10%">${new Intl.NumberFormat('en-US',{minimumFractionDigits:2,maximumFractionDigits:2}).format(.05*n.LINE_TOTAL+n.LINE_TOTAL)}</td>\n                                </tr>\n                                `})).join('')}\n                            \n                            </tbody>\n                            </table>\n                        </div>\n        \n                         \n                          \n        <div class="totals-section">\n                        <div   style="display:flex;flex-direction:column;width:100%;border:1px solid #000000;border-radius:5px;margin-top: 1px;">\n        \n                            <div style="width:100%">\n                                <div style="display:flex;justify-content:end;margin:10">\n                                    <div style="display:flex;justify-content:space-between;width:40%">\n                                        <label>Total Qty: </label>\n                                        <label style="min-width: 30%;margin-right: 10px;">${null==c?void 0:c.reduce((function(n,t){return n+t.QTY}),0)} </label>\n                                    </div>\n                                    <div style="display:flex;justify-content:space-between;width:40%">\n                                        <label>Total [Excl. VAT]: </label>\n                           