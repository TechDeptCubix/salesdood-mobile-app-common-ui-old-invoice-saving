   </div>\n                \n                    </div>  \n                    <div style="display:flex;width:100%;margin-top:10px">\n                            <div class="footer-received-panel" style="display:flex;width:60%">\n                                \n                             \n                                <div style="display:flex;flex-direction:column;width:50%">\n                                    <label style="font-weight: bold;">Received By</label>\n                                    <label></label>\n                                </div>\n                            \n                            </div>\n        \n                            <div style="display:flex;justify-content:end;width:40%;">\n                           \n                                <label class="loginUserLabel" style="margin-right:12px;>\n                                <div style="font-weight: bold;padding-left:50px;padding-top:5px"><label style="font-weight: bold;"> ${t(null==r?void 0:r.trim().toUpperCase())}</label></div>\n                                </label>\n                            </div>\n                        </div>  \n        </div>\n                    \n                    \n                   \n                </div>\n            </div>\n        \n           \n                </body>    \n                </html>`,_=`\n        <html>\n        <head>\n           <style>\n               body {\n                   display: flex;\n                   justify-content: center;\n                   align-items: center;\n                   margin: 0;\n                   padding: 0;\n                   background-color: white;\n               }\n        \n               .InvCard {\n                   display: flex;\n                   flex-direction: column;\n                   align-items: center;\n                   width: 100%;\n                    height: 96%;\n                   background-color: white;\n                   border-radius: 12px;\n     